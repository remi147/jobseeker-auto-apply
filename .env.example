# -- App ------------------------------------------------------------------
APP_NAME=JobSeeker Auto Apply
DEBUG=false
SECRET_KEY=change-me-in-production

# -- Database -------------------------------------------------------------
# SQLite (default, zero-config)
DATABASE_URL=sqlite:///./jobseeker.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/jobseeker

# -- Greenhouse ATS -------------------------------------------------------
GREENHOUSE_BOARD_TOKEN=
GREENHOUSE_API_KEY=

# -- Lever ATS ------------------------------------------------------------
LEVER_SITE=
LEVER_API_KEY=

# -- Matching & automation ------------------------------------------------
MIN_MATCH_SCORE=70.0
AUTO_APPLY=false
INGEST_INTERVAL_MINUTES=60

# -- File storage ---------------------------------------------------------
CV_UPLOAD_DIR=./uploads/cv
