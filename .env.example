# ── App ──────────────────────────────────────────────
APP_NAME=JobSeeker Auto Apply
DEBUG=false
SECRET_KEY=change-me-in-production

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./jobseeker.db

# ── Greenhouse ───────────────────────────────────────
GREENHOUSE_BOARD_TOKEN=your-board-token
GREENHOUSE_API_KEY=your-api-key

# ── Lever ────────────────────────────────────────────
LEVER_SITE=your-company-name
LEVER_API_KEY=your-lever-api-key

# ── Matching ─────────────────────────────────────────
MIN_MATCH_SCORE=70

# ── Submission ───────────────────────────────────────
# Set to true ONLY after testing review queue
AUTO_APPLY=false

# ── Scheduler ────────────────────────────────────────
# Interval in minutes between job ingestion runs
INGEST_INTERVAL_MINUTES=60
